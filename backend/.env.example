ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@127.0.0.1:6379/0
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
MAR_PREVIEW=false
MAR_TOOL_CALL_LIMIT=12
MAR_EMBEDDINGS=onnx
MAR_EMERGENCY_PHONE=当地急救电话
MAR_MODEL_TIMEOUT=35
MAR_AGENT_TIMEOUT=100
MAR_TOOL_TIMEOUT=20
MAR_MEMORY_TIMEOUT=20
# Chroma 会话摘要保留时长（秒），默认 7 天，过期后不再召回并定期删除
MAR_EPISODE_TTL_SECONDS=604800
MAR_SUPPORTING_AGENT_LIMIT=2
MAR_AGENT_CONCURRENCY=2
MAR_COLLABORATION_TIMEOUT=120
MAR_MONITOR_INTERVAL=10
MAR_MONITOR_WINDOW_SIZE=40
MAR_MONITOR_WINDOW_SECONDS=300
MAR_MONITOR_MIN_SAMPLES=5
MAR_MONITOR_AGENT_SUCCESS_RATE=0.90
MAR_MONITOR_AGENT_LATENCY_MS=15000
MAR_MONITOR_TOOL_SUCCESS_RATE=0.90
MAR_MONITOR_TOOL_LATENCY_MS=10000
MAR_MONITOR_LOCAL_TOOL_LATENCY_MS=1000
MAR_MONITOR_PENALTY_STEP=0.25
MAR_MONITOR_MAX_PENALTY=0.8
MAR_MONITOR_FALLBACK_PENALTY=0.5
MAR_MONITOR_BAD_TICKS=2
MAR_MONITOR_RECOVERY_SUCCESSES=2
MAR_MONITOR_RECOVERY_TICKS=2
MAR_MONITOR_PROBE_COOLDOWN=30
MAR_MONITOR_PROBE_TIMEOUT=15
# 备用实例（可选）：留空时两个实例都用主模型。填写后，只有主实例失败或被监控排除时才调用，角色请求（含用户原话）会发给 DeepSeek。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# Judge 模型（可选）：需要 DEEPSEEK_API_KEY，留空时 Judge 用主模型。换 Judge 后的分数不能和其他 Judge 的结果比较。
DEEPSEEK_JUDGE_MODEL=
